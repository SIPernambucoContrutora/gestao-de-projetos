# Conexão com o Neon (use a connection string "pooled" para runtime serverless).
# Painel Neon > Project > Connection Details > Connection string.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# String "direct" (sem -pooler), usada por drizzle-kit para migrations/DDL.
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# --- Neon Auth (Managed Better Auth, beta) ---
# Console Neon > projeto > Auth > Enable Auth > copie o "Auth URL" / "Base URL".
# IMPORTANTE: é o HOST puro do Neon Auth, SEM path (sem /<db>, sem /auth).
# O SDK (auth.handler) já anexa os caminhos internamente.
NEON_AUTH_BASE_URL="https://ep-xxxxxxxx.neonauth.<region>.aws.neon.tech"
# Segredo do cookie de sessão (>= 32 chars). Gere com: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="troque-por-um-segredo-aleatorio-de-32-chars-ou-mais"
