# Conexão com o Neon (use a connection string "pooled" para runtime serverless).
# Painel Neon > Project > Connection Details > Connection string.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# String "direct" (sem -pooler), usada por drizzle-kit para migrations/DDL.
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# --- Neon Auth (Managed Better Auth, beta) ---
# Console Neon > projeto > Auth > Enable Auth > copie o "Auth URL" / "Base URL".
# IMPORTANTE: é o HOST puro do Neon Auth, SEM path (sem /<db>, sem /auth).
# O SDK (auth.handler) já anexa os caminhos internamente.
NEON_AUTH_BASE_URL="https://ep-xxxxxxxx.neonauth.<region>.aws.neon.tech"
# Segredo do cookie de sessão (>= 32 chars). Gere com: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="troque-por-um-segredo-aleatorio-de-32-chars-ou-mais"

# --- Cron do aviso diário ---
# Token que autoriza /api/cron/vencimentos. SEM ele a rota fica FECHADA (401).
# Gere com: openssl rand -base64 32
# Na Vercel, basta cadastrar a variável: o Vercel Cron já manda o header
# Authorization: Bearer $CRON_SECRET sozinho. Na VPS, o curl do crontab
# precisa mandar o header na mão (ver README).
CRON_SECRET="troque-por-um-token-aleatorio"

# --- Envio de e-mail (Exchange Online via OAuth2 app-only) ---
# A caixa gestaodeprojetos@ envia por SMTP autenticado com OAuth, NÃO com
# usuário e senha: a Microsoft desativa o Basic Auth do SMTP AUTH por padrão
# no fim de dezembro/2026, com remoção definitiva em 2027.
#
# Os três valores abaixo vêm do registro de app no Entra ID (ver README —
# a configuração do lado da Microsoft tem passos em PowerShell que NÃO estão
# no portal, e sem eles o token é emitido mas o SMTP recusa com 535 5.7.3).
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# Segredo do app. EXPIRA (no máximo 24 meses) — anote a data de validade,
# porque o vencimento derruba o envio sem aviso prévio.
AZURE_CLIENT_SECRET="valor-do-segredo-do-app"

# A caixa que envia. Precisa ser a MESMA que recebeu Add-MailboxPermission
# para o service principal do app — é ela que vai no `user` do XOAUTH2.
SMTP_FROM="gestaodeprojetos@pernambucoconstrutora.com.br"
SMTP_FROM_NOME="Gestão das Obras"
# Opcionais: o padrão já é o Exchange Online.
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"

